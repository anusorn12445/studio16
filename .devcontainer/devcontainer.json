{
  "name": "studio16-go",
  "image": "mcr.microsoft.com/devcontainers/go:1-1.22",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "studio16 web", "onAutoForward": "openPreview" }
  },
  "remoteEnv": {
    "PORT": "8080",
    "WEB_DIR": "${containerWorkspaceFolder}/web",
    "DATA_DIR": "${containerWorkspaceFolder}/data"
  },
  "postCreateCommand": "go build -o /tmp/studio16-server ./cmd/server",
  "postAttachCommand": "pgrep -f studio16-server >/dev/null || nohup /tmp/studio16-server > /tmp/studio16.log 2>&1 &"
}
