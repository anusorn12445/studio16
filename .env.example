# Copy to .env and fill in. docker-compose reads this automatically.

# OpenAI — used for reading product photos and scoring the match report
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Gemini — used for video generation (Veo) and optionally vision
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash
VEO_MODEL=veo-3.1-generate-preview

# Match report
MATCH_THRESHOLD=75      # score >= this = ผ่าน (product matches)
MATCH_PROVIDER=openai   # openai | gemini — which vision model scores the match
